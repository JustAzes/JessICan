{#- Automatisch aus dem Inhalt erzeugt. Zola stellt hier `entries` bereit: jede
    Seite, Sektion und Taxonomie. Ausgefiltert werden Paginierungs-Umleitungen,
    die 404-Seite und leere Sammelseiten.

    Im Kontext dieses Templates gibt es kein `config`, deshalb steht die
    Basis-URL hier fest. -#}
{%- set base = "https://tierheilpraxis-jessican.de" -%}
{%- set skip = [
      "/404/",
      "/pages/",
      "/pages/blog/new/",
      "/categories/",
      "/tags/",
      "/elemente/"
    ] -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in entries %}
{%- set path = entry.permalink | replace(from=base, to="") %}
{%- if path is not containing("/page/") and path not in skip %}
  <url>
    <loc>{{ entry.permalink | escape_xml | safe }}</loc>
{%- if entry.updated %}
    <lastmod>{{ entry.updated }}</lastmod>
{%- endif %}
    <priority>{% if path == "/" %}1.0{% elif path is starting_with("/pages/blog/") %}0.6{% elif path is starting_with("/categories/") or path is starting_with("/tags/") %}0.4{% elif path is starting_with("/elemente/") or path is starting_with("/quiz") %}0.8{% else %}0.9{% endif %}</priority>
  </url>
{%- endif %}
{%- endfor %}
{#- Die allgemeine Elementeübersicht liegt unter /elemente/ und ist keine
    Zola-Sektion, deshalb steht sie hier ausdrücklich. -#}
  <url>
    <loc>{{ base | safe }}/elemente/</loc>
    <priority>0.9</priority>
  </url>
</urlset>
